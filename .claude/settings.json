{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew.bat:*)",
      "PowerShell(.\\gradlew.bat:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(find:*)",
      "Bash(du:*)",
      "Bash(unzip -l:*)",
      "Bash(javap:*)",

      "mcp__codegraph__*",
      "Bash(codegraph status:*)",
      "Bash(codegraph sync:*)",
      "Bash(codegraph query:*)",
      "Bash(codegraph context:*)",
      "Bash(codegraph callers:*)",
      "Bash(codegraph callees:*)",
      "Bash(codegraph impact:*)",
      "Bash(codegraph affected:*)"
    ],
    "deny": [
      "Read(./.sofa/**)"
    ]
  },
  "enabledMcpjsonServers": [
    "codegraph"
  ]
}
